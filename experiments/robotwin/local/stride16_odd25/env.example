#!/usr/bin/env bash
# Copy this file to env.local and replace every /ABS/... placeholder.

MACHINE_ID=ODD25_MACHINE

ADAPTIVE_COT_ROOT=/ABS/PATH/Adaptive-CoT-in-VLA
ROBOTWIN_ROOT=/ABS/PATH/RoboTwin
OPENPI_ROOT="$ROBOTWIN_ROOT/policy/pi05"
ZR0_ROOT=/ABS/PATH/ZR-0

PI05_CHECKPOINT=/ABS/PATH/checkpoints/motus-pi05-robotwin2
ZR0_CHECKPOINT=/ABS/PATH/checkpoints/ZR-0-robotwin
ZR0_ROBOTWIN_METADATA=/ABS/PATH/metadata/robotwin2.0-aloha-agilex

ROBOTWIN_PYTHON=/ABS/PATH/envs/robotwin-oft/bin/python
OPENPI_PYTHON=/ABS/PATH/envs/robotwin-openpi/bin/python
ZR0_PYTHON=/ABS/PATH/envs/zr0/bin/python

# CUDA_VISIBLE_DEVICES accepts either a physical index or a GPU UUID. UUIDs
# are safer if PCI enumeration changes after a reboot.
SIM_CUDA_DEVICE=GPU-REPLACE-WITH-SIM-GPU-UUID
PI05_CUDA_DEVICE=GPU-REPLACE-WITH-PI05-GPU-UUID

# Vulkan device selector used by SAPIEN on the simulator GPU. Obtain the PCI
# vendor/device pair with `lspci -nn | grep -i nvidia` (for RTX 3090: 10de:2204!).
SIM_MESA_DEVICE=10de:REPLACE!
export VK_ICD_FILENAMES=/etc/vulkan/icd.d/nvidia_icd.json

PI05_HOST=127.0.0.1
PI05_PORT=18100
ZR0_HOST=127.0.0.1
ZR0_PORT=18000

EXPERIMENT_ROOT=/ABS/PATH/results/pi05-zr0-stride16-crn-v1-odd25
INFERENCE_CACHE="$EXPERIMENT_ROOT/inference_cache.sqlite3"
MANIFEST_ROOT="$EXPERIMENT_ROOT/manifests/main"
CALIBRATION_MANIFEST_ROOT="$EXPERIMENT_ROOT/manifests/calibration"
PILOT_ROOT="$EXPERIMENT_ROOT/pilot"
THRESHOLDS_JSON="$EXPERIMENT_ROOT/thresholds/tasks25_step.json"
MAIN_ROOT="$EXPERIMENT_ROOT/main_25"
RUN_LOG_DIR="$EXPERIMENT_ROOT/runner_logs"

CLEAN_CALIBRATION_EPISODES=20
RANDOM_CALIBRATION_EPISODES=30
CLEAN_MAIN_EPISODES=50
RANDOM_MAIN_EPISODES=200
NUM_UNCERTAINTY_SAMPLES=5
ACTION_STEPS=32
REPLAN_STRIDE=16
COOLDOWN_STEPS=32
COT_RATIO=0.2

export HF_HOME=/ABS/PATH/cache/huggingface
export TMPDIR=/ABS/PATH/tmp
