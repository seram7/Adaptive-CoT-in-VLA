+
+def make_train_config(checkpoint_dir: str | Path) -> training_config.TrainConfig:
+    """Reconstruct the inference-relevant portion of the published train config."""
+
+    checkpoint = Path(checkpoint_dir).expanduser().resolve()
+    return training_config.TrainConfig(
+        name="motus_pi05_robotwin2",
+        project_name="pi05_finetune",
+        exp_name="robotwin_clean_randomized_joint_training",
+        model=pi0_config.Pi0Config(pi05=True, action_horizon=32),
+        data=training_config.LeRobotAlohaDataConfig(
+            repo_id="clean_randomized_joint_training",
+            assets=training_config.AssetsConfig(
+                assets_dir=str(checkpoint / "assets"),
+                asset_id=ASSET_ID,
+            ),
+            base_config=training_config.DataConfig(prompt_from_task=True),
+            adapt_to_pi=True,
+            use_delta_joint_actions=True,
+            repack_transforms=transforms.Group(),
+            action_sequence_keys=("actions",),
+        ),
+        seed=42,
+    )
+
+
+def create_policy(checkpoint_dir: str | Path, *, device: str = "cuda") -> _policy.Policy:
+    checkpoint = Path(checkpoint_dir).expanduser().resolve()
+    required = (
+        checkpoint / "model.safetensors",
+        checkpoint / "assets" / ASSET_ID / "norm_stats.json",
+    )
+    missing = [str(path) for path in required if not path.is_file()]
+    if missing:
+        raise FileNotFoundError(f"Incomplete Motus PI0.5 checkpoint; missing: {missing}")
+    return policy_config.create_trained_policy(
+        make_train_config(checkpoint),
+        checkpoint,
+        pytorch_device=device,
+    )
