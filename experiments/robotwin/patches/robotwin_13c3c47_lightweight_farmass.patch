@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""Serve the Motus RoboTwin PI0.5 checkpoint, optionally with Far Mass."""
+
+from __future__ import annotations
+
+import dataclasses
+import logging
+import socket
+
+import tyro
+
+from openpi.policies.motus_robotwin_policy import create_policy
+from openpi.policies.sampling_far_mass_policy import DEFAULT_NORMALIZED_RADII
+from openpi.policies.sampling_far_mass_policy import DEFAULT_PHYSICAL_RADII
+from openpi.policies.sampling_far_mass_policy import SamplingFarMassPolicy
+from openpi.serving.websocket_policy_server import WebsocketPolicyServer
+from openpi.uncertainty import FarMassConfig
+
+
+@dataclasses.dataclass
+class Args:
+    checkpoint_dir: str
+    host: str = "0.0.0.0"
+    port: int = 18100
+    device: str = "cuda"
+    compute_far_mass: bool = False
+    num_uncertainty_samples: int = 5
+    far_mass_radii: tuple[float, ...] = DEFAULT_PHYSICAL_RADII
+    normalized_far_mass_radii: tuple[float, ...] = DEFAULT_NORMALIZED_RADII
+
+
+def main(args: Args) -> None:
+    base_policy = create_policy(args.checkpoint_dir, device=args.device)
+    config = FarMassConfig(
+        num_uncertainty_samples=args.num_uncertainty_samples,
+        compute_far_mass=args.compute_far_mass,
+        far_mass_radii=args.far_mass_radii,
+        normalized_far_mass_radii=args.normalized_far_mass_radii,
+    )
+    policy = SamplingFarMassPolicy(base_policy, config)
+    hostname = socket.gethostname()
+    logging.info("Serving Motus PI0.5 on %s (%s:%d)", hostname, args.host, args.port)
+    WebsocketPolicyServer(
+        policy=policy,
+        host=args.host,
+        port=args.port,
+        metadata=policy.metadata,
+    ).serve_forever()
+
+
+if __name__ == "__main__":
+    logging.basicConfig(level=logging.INFO, force=True)
+    main(tyro.cli(Args))
