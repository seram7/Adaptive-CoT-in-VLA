+++ b/policy/pi05/src/openpi/policies/sampling_far_mass_policy.py
@@ -0,0 +1,124 @@
+"""Policy wrapper that adds sampling-based Far Mass to a PyTorch PI0.5 policy."""
+
+from __future__ import annotations
+
+import time
+
+import numpy as np
+from typing_extensions import override
+
+from openpi.policies import policy as _policy
+from openpi.uncertainty import FarMassConfig
+from openpi.uncertainty import compute_sampling_far_mass
+from openpi_client import base_policy as _base_policy
+
+
+# RoboTwin's ALOHA action is [left arm 6, left gripper, right arm 6, right
+# gripper]. Arm targets are radians; grippers are unitless normalized aperture.
+DEFAULT_ARM_JOINT_RADIUS_RAD = 0.05
+DEFAULT_GRIPPER_APERTURE_RADIUS = 0.10
+DEFAULT_PHYSICAL_RADII = (
+    *((DEFAULT_ARM_JOINT_RADIUS_RAD,) * 6),
+    DEFAULT_GRIPPER_APERTURE_RADIUS,
+    *((DEFAULT_ARM_JOINT_RADIUS_RAD,) * 6),
+    DEFAULT_GRIPPER_APERTURE_RADIUS,
+)
+DEFAULT_NORMALIZED_RADII = (0.10,) * 14
+DEFAULT_NORMALIZED_ACTION_DISTANCE_SCALES = (1.0,) * 14
+
+
+class SamplingFarMassPolicy(_base_policy.BasePolicy):
+    """Preserve ordinary inference unless Far Mass sampling is enabled."""
+
+    def __init__(self, policy: _policy.Policy, config: FarMassConfig):
+        self._policy = policy
+        self._config = config
+
+    @property
+    def metadata(self) -> dict:
+        return {
+            **self._policy.metadata,
+            "sampling_far_mass": {
+                "enabled": self._config.compute_far_mass,
+                "num_samples": self._config.num_uncertainty_samples,
+                "dominant_trajectory_method": "normalized_space_medoid",
+                "physical_radii": list(self._physical_radii()),
+                "normalized_radii": list(self._normalized_radii()),
+                "action_distance_scales": list(self._action_distance_scales()),
+            },
+        }
+
+    def _physical_radii(self) -> tuple[float, ...]:
+        return self._config.far_mass_radii or DEFAULT_PHYSICAL_RADII
+
+    def _normalized_radii(self) -> tuple[float, ...]:
+        return self._config.normalized_far_mass_radii or DEFAULT_NORMALIZED_RADII
+
+    def _action_distance_scales(self) -> tuple[float, ...]:
+        return self._config.action_distance_scales or DEFAULT_NORMALIZED_ACTION_DISTANCE_SCALES
+
+    def _metric(
+        self,
+        samples: np.ndarray,
+        radii: tuple[float, ...],
+        *,
+        dominant_sample_index: int | None = None,
+        pairwise_distances: np.ndarray | None = None,
+    ) -> dict:
+        return compute_sampling_far_mass(
+            samples,
+            radii,
+            action_scales=self._action_distance_scales(),
+            dominant_sample_index=dominant_sample_index,
+            pairwise_distances=pairwise_distances,
+        )
+
+    @override
+    def infer(self, obs: dict) -> dict:
+        if not self._config.compute_far_mass:
+            return self._policy.infer(obs)
+
+        request = dict(obs)
+        seed = request.pop("uncertainty_seed", None)
+        distribution = self._policy.infer_action_distribution(
+            request,
+            num_samples=self._config.num_uncertainty_samples,
+            seed=None if seed is None else int(seed),
+        )
+        normalized_samples = distribution["normalized_action_samples"][..., :14]
+        physical_samples = distribution["physical_action_samples"]
+
+        metric_started = time.monotonic()
+        normalized_metric = self._metric(normalized_samples, self._normalized_radii())
+        physical_metric = self._metric(
+            physical_samples,
+            self._physical_radii(),
+            dominant_sample_index=int(normalized_metric["dominant_sample_index"]),
+            pairwise_distances=np.asarray(normalized_metric["pairwise_distances"]),
+        )
+        metric_ms = (time.monotonic() - metric_started) * 1000
+
+        # Execute the batch-one reference trajectory, which uses the same first
+        # noise draw but preserves the original policy's batch-one BF16 numerics.
+        # Metric selection uses one coherent sampled trajectory as its medoid.
+        # Execution still uses the batch-one reference trajectory so enabling
+        # uncertainty does not change ordinary PI0.5 action numerics.
+        result = {
+            "actions": distribution["physical_reference_action"],
+            **physical_metric,
+            "normalized": normalized_metric,
+            "sampling_farmass_mean": float(np.mean(physical_metric["far_mass_uncertainty"])),
+            "sampling_far_mass_mean": float(np.mean(physical_metric["far_mass"])),
+            "sampling_mean_far_distance_mean": float(
+                np.mean(physical_metric["mean_far_distance"])
+            ),
+            "policy_timing": {
+                **distribution["policy_timing"],
+                "far_mass_metric_ms": metric_ms,
+            },
+        }
+        return result
+
+    @override
+    def reset(self) -> None:
+        self._policy.reset()
diff --git a/policy/pi05/src/openpi/uncertainty.py b/policy/pi05/src/openpi/uncertainty.py
